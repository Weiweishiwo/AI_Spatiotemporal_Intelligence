# ===== 配置模板：复制本文件为 .env 后填写，真 key 只填在 .env，勿提交 git =====

# --- 智能体 F：DeepSeek API（openai 兼容 SDK）---
# 到 https://platform.deepseek.com 申请，填到下面的占位符
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- 后端 D：MySQL（docker-compose 起，第二阶段接）---
# 连接串格式：mysql+pymysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+pymysql://root:AIzhigongzuoshi@127.0.0.1:3306/inspection