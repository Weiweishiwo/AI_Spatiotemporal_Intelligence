# 配置模板：复制一份改成 .env 使用（不要提交 .env 到 git）
# backend/config.py 里是默认值，和这里的注释一致，不配也能跑（JSON 数据源）

# ===== MySQL（第二阶段数据源；默认关闭）=====
# 开了但连不上库：服务会打印警告并自动回退 JSON，不影响 demo
MYSQL_ENABLED=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=inspection

# ===== DeepSeek（智能体 F 用，后端骨架阶段不调用）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
